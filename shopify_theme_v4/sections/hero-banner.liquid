
<section class="hero">
  <div class="hero__orbs">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>
  <div class="container hero__wrap">
    <div class="hero__badge"><span class="dot-live"></span> India's #1 Smart Lifestyle & Digital Store</div>
    <h1 class="hero__h1">Premium <span class="glow-txt">Lifestyle</span>, Smart <span class="glow-txt">Gadgets</span> & Digital <span class="glow-txt">Tools</span></h1>
    <p class="hero__p">Trending products, viral gadgets, premium templates & smart accessories. Instant digital download + Pan-India Cash on Delivery.</p>
    <div class="hero__btns">
      <a href="/collections/all" class="btn btn-glow">Shop Now &#x2192;</a>
      <a href="/collections/trending" class="btn btn-glass">Trending Products</a>
    </div>
    <!-- Countdown Timer -->
    <div class="hero__timer">
      <span class="timer-label">&#x1F525; Sale Ends In:</span>
      <div class="timer-boxes">
        <div class="t-box"><span id="t-hrs">23</span><small>Hours</small></div>
        <div class="t-sep">:</div>
        <div class="t-box"><span id="t-min">45</span><small>Min</small></div>
        <div class="t-sep">:</div>
        <div class="t-box"><span id="t-sec">59</span><small>Sec</small></div>
      </div>
    </div>
    <div class="hero__stats">
      <div class="h-stat"><strong>50,000+</strong><span>Happy Customers</span></div>
      <div class="h-stat"><strong>4.9 &#x2605;</strong><span>Avg Rating</span></div>
      <div class="h-stat"><strong>100%</strong><span>Secure</span></div>
      <div class="h-stat"><strong>24/7</strong><span>Support</span></div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Hero Banner","settings":[]}
{% endschema %}
