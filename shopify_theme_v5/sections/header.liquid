
<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <span class="logo-box">DK</span>
      <div class="logo-text">
        <span class="logo-name">Digital KnowOra</span>
        <small class="logo-tag">Explore Plus</small>
      </div>
    </a>
    <div class="header__search">
      <form action="/search" method="get" class="search-form">
        <input type="text" name="q" placeholder="Search for products, brands and more..." class="search-input" autocomplete="off">
        <button type="submit" class="search-btn" aria-label="Search">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
      </form>
    </div>
    <div class="header__actions">
      <a href="/account" class="hdr-action">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Account</span>
      </a>
      <a href="/cart" class="hdr-action cart-action">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>Cart</span>
        <span class="cart-badge">{{ cart.item_count }}</span>
      </a>
      <button class="mob-menu" onclick="document.getElementById('catBar').classList.toggle('open')" aria-label="Menu">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
{% schema %}
{"name":"Header","settings":[]}
{% endschema %}
