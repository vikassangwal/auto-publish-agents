
<section class="newsletter">
  <div class="container newsletter__inner">
    <div class="newsletter__content">
      <h2>Join 50,000+ Smart Shoppers</h2>
      <p>Get exclusive deals, new product alerts & free digital templates straight to your inbox.</p>
    </div>
    <div class="newsletter__form">
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="form-row">
          <input type="email" name="contact[email]" placeholder="Enter your email address" required>
          <button type="submit" class="btn btn--primary">Subscribe Free</button>
        </div>
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Newsletter","settings":[]}
{% endschema %}
