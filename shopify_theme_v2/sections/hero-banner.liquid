
<section class="hero">
  <div class="hero__bg-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
  </div>
  <div class="container hero__inner">
    <div class="hero__content">
      <div class="hero__badge">
        <span class="badge-dot"></span> India's #1 Smart Digital & Lifestyle Store
      </div>
      <h1 class="hero__title">
        Supercharge Your <span class="gradient-text">Productivity</span> &amp; <span class="gradient-text">Lifestyle</span>
      </h1>
      <p class="hero__desc">
        Premium Excel trackers, business templates &amp; viral trending gadgets — all in one store. Instant digital download + Pan-India Cash on Delivery.
      </p>
      <div class="hero__ctas">
        <a href="/collections/all" class="btn btn--primary">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          Shop Now
        </a>
        <a href="/collections/digital-tools" class="btn btn--glass">
          Explore Digital Tools →
        </a>
      </div>
      <div class="hero__metrics">
        <div class="metric"><strong>50K+</strong><span>Downloads</span></div>
        <div class="metric-divider"></div>
        <div class="metric"><strong>4.9★</strong><span>Rating</span></div>
        <div class="metric-divider"></div>
        <div class="metric"><strong>24/7</strong><span>Support</span></div>
        <div class="metric-divider"></div>
        <div class="metric"><strong>100%</strong><span>Secure</span></div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Hero Banner","settings":[]}
{% endschema %}
