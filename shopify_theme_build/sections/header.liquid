
<header class="site-header">
  <div class="container header-container">
    <div class="header-logo">
      <a href="/" class="logo-link">
        <span class="logo-badge">DK</span>
        <span class="logo-text">Digital <strong>KnowOra</strong></span>
      </a>
    </div>
    <nav class="header-nav">
      <a href="/" class="nav-link active">Home</a>
      <a href="/collections/all" class="nav-link">Digital Tools</a>
      <a href="/collections/all" class="nav-link">Trending Gadgets</a>
      <a href="/pages/contact" class="nav-link">Track Order</a>
    </nav>
    <div class="header-actions">
      <a href="/cart" class="cart-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-badge">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

