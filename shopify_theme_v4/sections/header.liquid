
<header class="hdr">
  <div class="container hdr__inner">
    <a href="/" class="hdr__logo">
      <span class="logo-mark">DK</span>
      <span class="logo-txt">Digital<b>KnowOra</b></span>
    </a>
    <nav class="hdr__nav" id="nav">
      <a href="/" class="nv active">Home</a>
      <a href="/collections/lifestyle" class="nv">Lifestyle</a>
      <a href="/collections/trending" class="nv">Trending</a>
      <a href="/collections/digital-tools" class="nv">Digital Tools</a>
      <a href="/collections/gadgets" class="nv">Gadgets</a>
      <a href="/pages/contact" class="nv">Contact</a>
    </nav>
    <div class="hdr__acts">
      <a href="/search" class="hdr__btn" aria-label="Search">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </a>
      <a href="/cart" class="hdr__btn cart-i" aria-label="Cart">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-c">{{ cart.item_count }}</span>
      </a>
      <button class="mob-btn" onclick="document.getElementById('nav').classList.toggle('open')" aria-label="Menu">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
{% schema %}
{"name":"Header","settings":[]}
{% endschema %}
