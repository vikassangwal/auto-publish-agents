# ==============================================================================
# DIGITAL PRODUCT AUTO-PUBLISHER AGENT — CREDENTIALS CONFIGURATION
# ==============================================================================
# IMPORTANT: Never commit this file with real secret values to Git or chat.
# Copy this file to '.env' in this directory and fill in the keys you want to use.

# ------------------------------------------------------------------------------
# 1. GUMROAD (Official API v2)
# Get from: https://app.gumroad.com/settings/advanced -> Create Personal Access Token
# ------------------------------------------------------------------------------
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here

# ------------------------------------------------------------------------------
# 2. LEMON SQUEEZY (Merchant of Record API v1)
# Get from: https://app.lemonsqueezy.com/settings/api -> New API Key
# Store ID: Find in Settings -> Stores (e.g. 12345)
# ------------------------------------------------------------------------------
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here
LEMON_SQUEEZY_STORE_ID=your_store_id_here

# ------------------------------------------------------------------------------
# 3. WHOP (Software & Digital Communities API v5)
# Get from: https://dash.whop.com/developer -> API Keys
# ------------------------------------------------------------------------------
WHOP_API_KEY=your_whop_api_key_here
WHOP_COMPANY_ID=your_whop_company_id_here

# ------------------------------------------------------------------------------
# 4. PAYHIP (Digital Downloads API)
# Get from: https://payhip.com/account/settings
# ------------------------------------------------------------------------------
PAYHIP_API_KEY=your_payhip_api_key_here

# ------------------------------------------------------------------------------
# 5. USER'S OWN WEBSITES (WooCommerce / Shopify / Custom REST Webhook)
# Endpoint where your site accepts product payloads (POST JSON)
# ------------------------------------------------------------------------------
CUSTOM_STORE_ENDPOINT=https://your-domain.com/wp-json/autopublish/v1/product
CUSTOM_STORE_AUTH=Bearer your_custom_secret_token_here

# ------------------------------------------------------------------------------
# 6. NOTIFICATION ALERTS (Optional: Telegram Bot / Discord Webhook)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
